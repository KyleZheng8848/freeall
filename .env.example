# Optional maintainer-only OSS publishing configuration.
# Building, running and testing FreeAll do not require these variables.
# Copy to .env.local and use your own bucket and credentials.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
FREEALL_OSS_TARGET=oss://your-bucket/FreeAll/
FREEALL_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
FREEALL_DOWNLOAD_BASE_URL=https://your-bucket.oss-cn-hangzhou.aliyuncs.com/FreeAll/
